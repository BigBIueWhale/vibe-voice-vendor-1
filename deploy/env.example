# VibeVoice ASR Server — Runtime CLI Reference
#
# setup.sh renders systemd user units from the current checkout path. This file
# documents the runtime arguments only; it is not read by setup.sh.
#
# Example direct invocation from the project root:
#
#   python -m server \
#     --vllm-base-url http://127.0.0.1:8000 \
#     --uds /run/vibevoice/server.sock \
#     --max-audio-bytes 524288000 \
#     --max-queue-size 50 \
#     --jwt-public-key-file ./keys/public.pem \
#     --revoked-tokens-file ./revoked_tokens.txt \
#     --require-https true \
#     --vllm-model-name vibevoice \
#     --vllm-temperature 0.0 \
#     --vllm-top-p 1.0
#
# Generate key pair + token with:
#   uv run python -m scripts.generate_token --keys-dir keys --subject user
# Validate key pair + token with:
#   uv run python -m scripts.validate_auth_artifacts --keys-dir keys
# Generate mTLS client-auth artifacts with:
#   uv run python -m scripts.generate_client_cert --certs-dir certs/self-signed --keys-dir keys --subject user
# Validate mTLS client-auth artifacts with:
#   uv run python -m scripts.validate_client_cert --certs-dir certs/self-signed --keys-dir keys
#
# Rust proxy (vvv_proxy) — all arguments required:
#
#   ./vvv_proxy \
#     --upstream-uds "$HOME/.config/vibevoice-vendor/run/server.sock" \
#     --upstream-peer-uid "$(id -u)" \
#     --upstream-peer-gid "$(id -g)" \
#     --listen-host 0.0.0.0 \
#     --listen-port 42862 \
#     --max-body-size 525336576 \
#     --jwt-public-key-file ./keys/public.pem \
#     --revoked-tokens-file ./revoked_tokens.txt \
#     --cert-path certs/self-signed/fullchain.pem \
#     --key-path certs/self-signed/privkey.pem \
#     --server-spki-pin-path certs/self-signed/server-spki-pin.txt \
#     --client-ca-cert-path certs/self-signed/client-ca.pem \
#     --cert-validity-days 3650 \
#     --cert-check-interval-secs 3600
